{
  "compilerOptions": {
    "strict": true, "module": "ESNext", "moduleResolution": "bundler",
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"], "allowJs": true, "checkJs": false,
    "isolatedModules": true, "verbatimModuleSyntax": true, "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"]
}
