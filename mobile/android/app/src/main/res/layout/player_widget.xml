<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="8dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_text" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="#FAFCF7" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_resume" android:textColor="#CCDBCA" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_previous" android:layout_width="44dp" android:layout_height="48dp"
        android:background="@android:color/transparent" android:src="@drawable/widget_previous" android:contentDescription="@string/widget_previous" />
    <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@android:color/transparent" android:src="@drawable/widget_play" android:contentDescription="@string/widget_play" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="48dp"
        android:background="@android:color/transparent" android:src="@drawable/widget_next" android:contentDescription="@string/widget_next" />
</LinearLayout>
